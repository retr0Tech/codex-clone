# Copy to .env.local at the REPOSITORY ROOT and fill in APP_ENCRYPTION_KEY.
# Both the web app and the worker read this one file. .env* is gitignored --
# never commit real values.
#
# NOTE: your GitHub PAT and OpenAI API key are NOT set here. They are entered
# in the Settings page and stored AES-256-GCM encrypted in Postgres. Only the
# encryption key below lives in the environment.

# --- Required -------------------------------------------------------------

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- Everything below has a working default; uncomment only to override ----

DATABASE_URL=postgres://codex:codex@localhost:5432/codex_clone
POSTGRES_DB=codex_clone
POSTGRES_PORT=5432

# Docker Desktop creates a PER-USER socket. The default is
# $HOME/.docker/run/docker.sock, which is correct on a normal install. Override
# only if yours lives elsewhere -- note that /var/run/docker.sock may be a
# symlink into a different user's home and unreadable by you.
# DOCKER_SOCKET=/Users/you/.docker/run/docker.sock

BIND_HOST=127.0.0.1
WEB_PORT=3000
WORKER_WS_PORT=8787
# Must agree with WORKER_WS_PORT -- the browser and the web app's server routes
# both reach the worker through this URL.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8787

# Which checkout this is. Containers are labelled with it and the worker's boot
# reconciliation is filtered by it, so a second checkout running at the same
# time cannot mistake this one's live sandboxes for orphans and destroy them.
# .conductor/setup.sh sets it per workspace; leave it alone otherwise.
# CODEX_WORKSPACE_ID=default

AGENT_IMAGE=codex-clone/agent:dev
MAX_CONCURRENT_SANDBOXES=3

# Shared package-manager cache mounted into every sandbox at /cache. This is a
# known cross-workspace channel -- a hostile agent can poison it for the next
# task -- so production namespaces it per tenant. Blank disables the mount.
# CACHE_VOLUME_NAME=codex-clone-cache
# A workspace idle this long is exported to a cold tar.zst snapshot and its
# Docker volume is freed. The next turn restores it. Nothing is lost either
# way -- the snapshot carries uncommitted edits and .git.
IDLE_REAP_MS=900000
# How often the reaper looks. A minute is precise enough for a 15-minute TTL.
REAPER_POLL_MS=60000
SCHEDULER_TICK_MS=30000

# Host-side state: bare repo mirrors and cold workspace snapshots.
# Defaults to $HOME/.codexclone
# CODEX_DATA_DIR=
