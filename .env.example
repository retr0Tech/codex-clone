# Copy to .env.local and fill in. .env* is gitignored -- never commit real values.
#
# NOTE: the GitHub PAT and OpenAI API key are NOT set here. They are entered in
# the Settings page and stored AES-256-GCM encrypted in Postgres. Only the
# encryption key below lives in the environment.

DATABASE_URL=postgres://codex:codex@localhost:5432/codex_clone
POSTGRES_DB=codex_clone
POSTGRES_PORT=5432

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Docker Desktop uses a per-user socket. If another macOS account installed
# Docker first, /var/run/docker.sock points into THAT user's home and is not
# readable here, so we address the socket explicitly.
DOCKER_SOCKET=/Users/CHANGEME/.docker/run/docker.sock

BIND_HOST=127.0.0.1
WORKER_WS_PORT=8787
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8787

AGENT_IMAGE=codex-clone/agent:dev
MAX_CONCURRENT_SANDBOXES=3
IDLE_REAP_MS=900000
SCHEDULER_TICK_MS=30000

# Host-side state: bare repo mirrors and cold workspace snapshots.
CODEX_DATA_DIR=
