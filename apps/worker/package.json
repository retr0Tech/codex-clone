{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codex-clone/core": "workspace:*",
    "@codex-clone/cron": "workspace:*",
    "@codex-clone/db": "workspace:*",
    "@codex-clone/github": "workspace:*",
    "@codex-clone/sandbox-docker": "workspace:*",
    "@codex-clone/secrets": "workspace:*",
    "dockerode": "^4.0.4",
    "drizzle-orm": "^0.38.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
